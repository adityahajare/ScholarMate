{
  "buildCommand": "cd SchlorMate/SchlorMate && npm ci && npm run build",
  "outputDirectory": "SchlorMate/SchlorMate/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://scholarmate-backend1.onrender.com/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
