# Local development defaults. Never commit real credentials or tokens.
SCHOLARMATE_DB_USERNAME=postgres
SCHOLARMATE_DB_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/scholarmate_db
SCHOLARMATE_ML_BASE_URL=http://localhost:8000
SCHOLARMATE_DOCUMENT_STORAGE_DIR=./data/profile-documents
SCHOLARMATE_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
SCHOLARMATE_JWT_ACCESS_EXPIRATION_MS=900000
SCHOLARMATE_JWT_REFRESH_EXPIRATION_MS=604800000
SCHOLARMATE_FRONTEND_URL=http://localhost:5173,https://schlor-mate.vercel.app,https://scholarmate-frontend.onrender.com,https://scholar-mate-7kxx.vercel.app
SCHOLARMATE_SOURCES_INITIALIZE=true
SCHOLARMATE_SCRAPER_SCHEDULE_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
LLM_API_KEY=
VITE_API_URL=https://scholarmate-backend1.onrender.com
